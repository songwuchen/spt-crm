# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spt_crm

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# File upload directory
UPLOAD_DIR=uploads

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:3000

# AI Provider: mock | openai | azure
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1

# Encryption key for sensitive integration config (32+ chars recommended)
ENCRYPTION_KEY=

# 阿里云 IMM WebOffice（旧版 .doc / PPT / 复杂表格在线预览）
# 留空 IMM_PROJECT = 关闭；附件须落在阿里云 OSS，且与 IMM 项目同地域
IMM_PROJECT=
IMM_REGION=
IMM_ENDPOINT=

# 简道云等外部数据由中间服务 crm-integration 拉取后，经开放平台推入本 CRM：
#   POST /openapi/v1/contracts  (X-API-Key + Idempotency-Key, scope crm.contract.write)
# 本服务不再配置 JDY_WRAPPER_* / 不跑 jdy_contract_sync_worker。
